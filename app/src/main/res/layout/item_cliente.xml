<?xml version="1.0" encoding="utf-8"?>
<!--
    Layout mínimo restaurado para que ClientAdapter.kt (pantalla de
    Clientes, fuera del alcance de veterinaria y marcada como
    desactualizada) siga compilando. El contenido veterinario que
    antes vivía en este archivo se movió a fragment_agendar_cita.xml.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="12dp">

    <TextView
        android:id="@+id/tv_nombre"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="#1A1A2E" />

    <TextView
        android:id="@+id/tv_clave"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="13sp"
        android:textColor="#6B7280" />

</LinearLayout>
