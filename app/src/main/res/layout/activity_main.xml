<?xml version="1.0" encoding="utf-8"?>
<!--
    MainActivity ahora solo aloja el grafo de navegación (NavHostFragment).
    Todo el contenido que antes vivía aquí (saludo, menú de tarjetas,
    próximas citas) se movió a fragment_home.xml / HomeFragment, que es
    ahora el primer destino real dentro del grafo de navegación.
-->
<androidx.fragment.app.FragmentContainerView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nav_host_fragment"
    android:name="androidx.navigation.fragment.NavHostFragment"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:defaultNavHost="true"
    app:navGraph="@navigation/nav_graph" />
